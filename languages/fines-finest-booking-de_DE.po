#: includes/class-ffb-admin.php:1083
#, php-format
msgid "One question per line: %s. Types: text, textarea, tel, url. Name and email are always asked."
msgstr "Eine Frage pro Zeile: %s. Typen: text, textarea, tel, url. Name und E-Mail werden immer abgefragt."

#: includes/class-ffb-admin.php:1084
msgid "Label | type | required"
msgstr "Label | typ | pflicht"

