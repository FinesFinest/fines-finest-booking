#, php-format
msgid "This appointment type still has %d upcoming appointment."
msgid_plural "This appointment type still has %d upcoming appointments."
msgstr[0] "Dieser Termintyp hat noch %d künftigen Termin."
msgstr[1] "Dieser Termintyp hat noch %d künftige Termine."

#: includes/class-ffb-admin.php:127
msgid "Cancel those appointments first, or untick \"Bookable\" on the appointment type until they are over."
msgstr "Sag die Termine erst ab oder nimm dem Termintyp den Haken „Buchbar“, bis sie vorbei sind."

#: includes/class-ffb-admin.php:143
msgid "Test email from Fines Finest Booking"
msgstr "Testmail von Fines Finest Booking"

#: includes/class-ffb-admin.php:144
msgid "This email comes from the booking plugin. If you can read it, sending works."
msgstr "Diese Mail kommt aus dem Buchungs-Plugin. Wenn du sie liest, funktioniert der Versand."

#: includes/class-ffb-admin.php:144
msgid "Please also check whether it landed in your spam folder."
msgstr "Prüf bitte auch, ob sie im Spam gelandet ist."

#: includes/class-ffb-admin.php:152
