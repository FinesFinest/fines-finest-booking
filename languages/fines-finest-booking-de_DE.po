msgstr "Termine dieses Typs pro Tag (0 = kein Limit)"

#: includes/class-ffb-admin.php:1030
msgid "Title in calendar"
msgstr "Titel im Kalender"

#. translators: 1: list of placeholders, 2: default title
#: includes/class-ffb-admin.php:1038
#, php-format
msgid "This is the title of the entry in your Google Calendar. Placeholders: %1$s. Leave empty for %2$s."
msgstr "So heißt der Eintrag in deinem Google-Kalender. Platzhalter: %1$s. Leer lassen ergibt %2$s."

#: includes/class-ffb-admin.php:1049
#: includes/class-ffb-admin.php:1372
msgid "Blocked days"
msgstr "Sperrtage"

#: includes/class-ffb-admin.php:1052
msgid "Single days in the format YYYY-MM-DD, separated by commas. For holidays, add an all-day event in your Google Calendar instead, it is taken into account automatically."
msgstr "Einzelne Tage im Format JJJJ-MM-TT, mit Komma getrennt. Urlaub trägst du besser direkt im Google-Kalender ein, das wird automatisch berücksichtigt."

#: includes/class-ffb-admin.php:1056
msgid "Location"
msgstr "Ort"

#: includes/class-ffb-admin.php:1061
msgid "Google Meet (link is created automatically)"
msgstr "Google Meet (Link wird automatisch erzeugt)"

#: includes/class-ffb-admin.php:1062
